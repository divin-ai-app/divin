APP_NAME="divin.ai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://divin.ai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (MySQL, cPanel-provisioned — see plan §1) ----------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Site is HTTPS-only (see public/.htaccess) — refuse to ever send the
# session cookie over a plain-HTTP connection. Leave unset (or false) only
# for local HTTP development.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (production: Resend — config/services.php + config/mail.php) ------
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@divin.ai"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# --- Stripe (scaffold only — see plan §1/§8) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_REGISTERED=
STRIPE_PRICE_ID_MANAGED=

# --- Internal service-to-service secrets -------------------------------------
# Shared secret the future ingestion pipeline must send as X-Ingestion-Key.
INGESTION_API_KEY=
# Shared secret the cPanel Cron Job must pass to /api/cron/freshness-check.
CRON_SECRET=
