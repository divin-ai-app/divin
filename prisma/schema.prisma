// divin.ai — Prisma schema
// Provider: MySQL/MariaDB (cPanel-hosted, no root access — see plan §1/§8).
// Client: the new unified "prisma-client" generator (Prisma 7), used via the
// @prisma/adapter-mariadb driver adapter (see src/lib/db.ts).
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  EDITOR
  STAFF
  ADMIN
}

enum Industry {
  HEALTHCARE
  HOSPITALITY
  RETAIL
  FOOD
  FINANCIAL_SERVICES
  OTHER
}

enum ClaimStatus {
  UNCLAIMED
  PENDING_CLAIM
  CLAIMED
  VERIFIED
}

enum PlanTier {
  NONE
  REGISTERED
  MANAGED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  REMOVED
}

enum SourceType {
  FACEBOOK
  OTA_BOOKING
  OTA_AGODA
  OTA_TRIPADVISOR
  OWN_WEBSITE
  REGISTRY
  GBP_ADJACENT
  OWNER_SUBMITTED
}

enum CoherenceStatus {
  ALIGNED
  MINOR_DRIFT
  MAJOR_DRIFT
  UNREACHABLE
  NOT_CHECKED
}

enum VerificationMethod {
  EMAIL_MATCH
  PHONE_MATCH
  DOCUMENT_UPLOAD
  ADMIN_CODE
}

enum ClaimRequestStatus {
  SUBMITTED
  AWAITING_VERIFICATION
  VERIFIED
  APPROVED
  REJECTED
}

enum BillingCycle {
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
  UNCOLLECTIBLE
}

enum FreshnessSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ResolutionAction {
  ACCEPTED_NEW_VALUE
  KEPT_CURRENT_VALUE
}

enum DisputeType {
  NOT_MY_BUSINESS
  INCORRECT_DATA
  DUPLICATE
  UNWANTED_LISTING
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  CORRECTED
  REMOVED
  REJECTED
}

enum LegalStatus {
  NOT_STARTED
  IN_REVIEW
  CLEARED
  EXCLUDED_GDPR
}

enum BotName {
  GPTBOT
  OAI_SEARCHBOT
  CLAUDEBOT
  PERPLEXITYBOT
  GOOGLE_EXTENDED
  GOOGLEBOT
  BINGBOT
  OTHER
}

enum IngestionRunStatus {
  SUCCESS
  PARTIAL
  FAILED
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 — Prisma adapter shape)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(OWNER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownerships         ProfileOwnership[]
  claimRequests      ClaimRequest[]     @relation("ClaimRequester")
  reviewedClaims     ClaimRequest[]     @relation("ClaimReviewer")
  claimAuditEvents   ClaimAuditEvent[]  @relation("ClaimAuditActor")
  submittedDisputes  Dispute[]          @relation("DisputeSubmitter")
  resolvedDisputes   Dispute[]          @relation("DisputeResolver")
  reviewedClearances CountryClearance[] @relation("ClearanceReviewer")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core registry
// ---------------------------------------------------------------------------

model BusinessProfile {
  id               String        @id @default(cuid())
  canonicalId      String        @unique
  slug             String        @unique
  name             String
  legalName        String?
  industry         Industry
  category         String
  countryCode      String
  city             String
  addressLine1     String
  addressLine2     String?
  postalCode       String?
  lat              Float?
  lng              Float?
  phone            String?
  publicEmail      String?
  website          String?
  descriptionShort String        @db.Text
  descriptionLong  String?       @db.Text
  hours            Json?
  priceRange       String?
  status           ProfileStatus @default(DRAFT)
  claimStatus      ClaimStatus   @default(UNCLAIMED)
  planTier         PlanTier      @default(NONE)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastVerifiedAt DateTime?
  publishedAt    DateTime?

  countryClearance CountryClearance @relation(fields: [countryCode], references: [countryCode])

  dataSources        DataSource[]
  claimRequests      ClaimRequest[]
  owners             ProfileOwnership[]
  subscription       Subscription?
  freshnessLogs      FreshnessCheckLog[]
  crawlerVisitsRaw   CrawlerVisitLog[]
  crawlerVisitsDaily CrawlerVisitDailyAgg[]
  disputes           Dispute[]
  services           ProfileService[]
  images             ProfileImage[]

  @@index([countryCode])
  @@index([industry])
  @@index([status])
  @@index([claimStatus])
  @@map("business_profiles")
}

model ProfileService {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  description String? @db.Text
  price       String?
  sortOrder   Int     @default(0)

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_services")
}

model ProfileImage {
  id        String   @id @default(cuid())
  profileId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_images")
}

model ProfileOwnership {
  id                       String   @id @default(cuid())
  userId                   String
  profileId                String
  role                     Role     @default(OWNER)
  grantedAt                DateTime @default(now())
  grantedViaClaimRequestId String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@index([profileId])
  @@map("profile_ownerships")
}

model DataSource {
  id              String          @id @default(cuid())
  profileId       String
  sourceType      SourceType
  sourceUrl       String?
  contactEmail    String?
  contactPhone    String?
  lastCheckedAt   DateTime?
  currentSnapshot Json
  coherenceStatus CoherenceStatus @default(NOT_CHECKED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  profile       BusinessProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  freshnessLogs FreshnessCheckLog[]

  @@index([profileId])
  @@index([sourceType])
  @@map("data_sources")
}

// ---------------------------------------------------------------------------
// Claim flow
// ---------------------------------------------------------------------------

model ClaimRequest {
  id                 String             @id @default(cuid())
  profileId          String
  requestedByUserId  String
  verificationMethod VerificationMethod
  contactValue       String
  status             ClaimRequestStatus @default(SUBMITTED)
  otpHash            String?
  otpExpiresAt       DateTime?
  documentUrl        String?
  reviewedByStaffId  String?
  reviewNotes        String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  profile    BusinessProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requester  User              @relation("ClaimRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("ClaimReviewer", fields: [reviewedByStaffId], references: [id])
  events     ClaimAuditEvent[]

  @@index([profileId])
  @@index([status])
  @@map("claim_requests")
}

model ClaimAuditEvent {
  id             String   @id @default(cuid())
  claimRequestId String
  actorUserId    String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  claimRequest ClaimRequest @relation(fields: [claimRequestId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ClaimAuditActor", fields: [actorUserId], references: [id])

  @@index([claimRequestId])
  @@map("claim_audit_events")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  profileId            String             @unique
  tier                 PlanTier
  billingCycle         BillingCycle       @default(ANNUAL)
  status               SubscriptionStatus
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  renewalDate          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  profile  BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(cuid())
  subscriptionId  String
  stripeInvoiceId String        @unique
  amountCents     Int
  currency        String        @default("usd")
  status          InvoiceStatus
  issuedAt        DateTime
  pdfUrl          String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Managed tier: freshness / coherence monitoring
// ---------------------------------------------------------------------------

model FreshnessCheckLog {
  id               String            @id @default(cuid())
  profileId        String
  dataSourceId     String?
  checkedAt        DateTime          @default(now())
  discrepancies    Json
  severity         FreshnessSeverity
  alertSent        Boolean           @default(false)
  alertSentAt      DateTime?
  resolvedAt       DateTime?
  resolutionAction ResolutionAction?

  profile    BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dataSource DataSource?     @relation(fields: [dataSourceId], references: [id])

  @@index([profileId])
  @@map("freshness_check_logs")
}

// ---------------------------------------------------------------------------
// AI crawler visibility
// ---------------------------------------------------------------------------

model CrawlerVisitLog {
  id        String   @id @default(cuid())
  profileId String
  botName   BotName
  path      String
  userAgent String   @db.Text
  ipHash    String
  timestamp DateTime @default(now())

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, timestamp])
  @@map("crawler_visit_logs")
}

model CrawlerVisitDailyAgg {
  id         String   @id @default(cuid())
  profileId  String
  date       DateTime @db.Date
  botName    BotName
  visitCount Int      @default(0)

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date, botName])
  @@index([profileId])
  @@map("crawler_visit_daily_aggs")
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

model Dispute {
  id                String        @id @default(cuid())
  profileId         String
  submittedByUserId String?
  submitterEmail    String
  type              DisputeType
  description       String        @db.Text
  status            DisputeStatus @default(OPEN)
  resolutionNotes   String?       @db.Text
  resolvedByStaffId String?
  createdAt         DateTime      @default(now())
  resolvedAt        DateTime?

  profile     BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  submittedBy User?           @relation("DisputeSubmitter", fields: [submittedByUserId], references: [id])
  resolvedBy  User?           @relation("DisputeResolver", fields: [resolvedByStaffId], references: [id])

  @@index([profileId])
  @@index([status])
  @@map("disputes")
}

// ---------------------------------------------------------------------------
// Country clearance & ingestion pipeline status
// ---------------------------------------------------------------------------

model CountryClearance {
  id                String      @id @default(cuid())
  countryCode       String      @unique
  countryName       String
  legalStatus       LegalStatus @default(NOT_STARTED)
  gdprExcluded      Boolean     @default(false)
  notes             String?     @db.Text
  clearedAt         DateTime?
  reviewedByStaffId String?
  updatedAt         DateTime    @updatedAt

  reviewedBy User?             @relation("ClearanceReviewer", fields: [reviewedByStaffId], references: [id])
  profiles   BusinessProfile[]

  @@map("country_clearances")
}

model IngestionSourceStatus {
  id               String              @id @default(cuid())
  countryCode      String
  sourceType       SourceType
  lastRunAt        DateTime?
  lastRunStatus    IngestionRunStatus?
  recordsIngested  Int                 @default(0)
  recordsFailed    Int                 @default(0)
  nextScheduledRun DateTime?

  @@unique([countryCode, sourceType])
  @@map("ingestion_source_statuses")
}
