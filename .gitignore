/node_modules
# NOT ignored: /public/build. The cPanel host has no Node runtime, so
# compiled Vite/Tailwind output is committed — run `npm run build` locally
# before pushing any change under resources/css or resources/js. See
# .cpanel.yml.
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

# cPanel's PHP version manager touches public/.htaccess (its actual edit —
# a "do not edit" comment block — is merged into the tracked file below) and
# leaves timestamped backup copies here every time it does. Left untracked,
# these silently block the next `cpanel.yml` deploy ("uncommitted changes
# exist"). See README.md.
/public/.htaccess.phpupgrader.*
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
